{
    "name": "thijsdezoete/tinify-statamic",
    "description": "Automatic image optimization, conversion and thumbnails powered by TinyPNG",
    "type": "statamic-addon",
    "license": "MIT",
    "homepage": "https://github.com/thijsdezoete/tinify-statamic",
    "authors": [
        {
            "name": "Thijs de Zoete",
            "homepage": "https://github.com/thijsdezoete"
        }
    ],
    "support": {
        "issues": "https://github.com/thijsdezoete/tinify-statamic/issues",
        "source": "https://github.com/thijsdezoete/tinify-statamic"
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "tinify/tinify": "^1.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tinify\\Statamic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tinify\\Statamic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Tinify",
            "description": "Automatic image optimization, conversion and thumbnails powered by TinyPNG"
        },
        "laravel": {
            "providers": [
                "Tinify\\Statamic\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
